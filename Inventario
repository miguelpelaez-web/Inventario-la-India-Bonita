        function getFilteredProducts() {
            const search = document.getElementById('searchInput').value.toLowerCase();
            const category = document.getElementById('categoryFilter').value;
            const status = document.getElementById('statusFilter').value;

            return products.filter(p => {
                const matchesSearch = p.name.toLowerCase().includes(search) || p.sku.toLowerCase().includes(search);
                const matchesCategory = category === 'ALL' || p.category === category;
                
                let matchesStatus = true;
                if (status === 'NORMAL') matchesStatus = p.stock > p.minStock;
                if (status === 'LOW') matchesStatus = p.stock <= p.minStock && p.stock > 0;
                if (status === 'OUT') matchesStatus = p.stock === 0;

                return matchesSearch && matchesCategory && matchesStatus;
            });
        }

        function applyFilters() {
            renderInventoryTable();
        }

        // --- CRUD PRODUCTOS ---
        function openProductModal(editId = null) {
            const modal = document.getElementById('productModal');
            const form = document.getElementById('productForm');
            const title = document.getElementById('productModalTitle');

            form.reset();
            document.getElementById('prodId').value = '';

            if (editId) {
                const p = products.find(prod => prod.id === editId);
                if (p) {
                    title.innerText = 'Editar Producto';
                    document.getElementById('prodId').value = p.id;
                    document.getElementById('prodSku').value = p.sku;
                    document.getElementById('prodName').value = p.name;
                    document.getElementById('prodCategory').value = p.category;
                    document.getElementById('prodStock').value = p.stock;
                    document.getElementById('prodMinStock').value = p.minStock;
                    document.getElementById('prodCost').value = p.cost;
                    document.getElementById('prodLocation').value = p.location || '';
                }
            } else {
                title.innerText = 'Agregar Producto';
            }

            modal.classList.remove('hidden');
        }

        function closeProductModal() {
            document.getElementById('productModal').classList.add('hidden');
        }

        function handleProductSubmit(e) {
            e.preventDefault();

            const id = document.getElementById('prodId').value;
            const sku = document.getElementById('prodSku').value.trim();
            const name = document.getElementById('prodName').value.trim();
            const category = document.getElementById('prodCategory').value.trim();
            const stock = parseInt(document.getElementById('prodStock').value);
            const minStock = parseInt(document.getElementById('prodMinStock').value);
            const cost = parseFloat(document.getElementById('prodCost').value);
            const location = document.getElementById('prodLocation').value.trim();

            if (id) {
                // Modificar producto existente
                const idx = products.findIndex(p => p.id === id);
                if (idx !== -1) {
                    products[idx] = { id, sku, name, category, stock, minStock, cost, location };
                    showToast('Producto actualizado con éxito', 'success');
                }
            } else {
                // Crear nuevo producto
                const newId = Date.now().toString();
                products.push({ id: newId, sku, name, category, stock, minStock, cost, location });
                
                // Registrar movimiento inicial
                movements.unshift({
                    id: Date.now().toString() + '-m',
                    date: new Date().toLocaleString(),
                    productId: newId,
                    productName: name,
                    type: 'IN',
                    quantity: stock,
                    notes: 'Carga de stock inicial'
                });

                showToast('Producto agregado al inventario', 'success');
            }

            saveData();
            populateCategoryFilter();
            renderDashboard();
            renderInventoryTable();
            closeProductModal();
        }

        function editProduct(id) {
            openProductModal(id);
        }

        function deleteProduct(id) {
            const p = products.find(prod => prod.id === id);
            if (!p) return;

            if (confirm(`¿Estás seguro de que deseas eliminar el producto "${p.name}"?`)) {
                products = products.filter(prod => prod.id !== id);
                saveData();
                populateCategoryFilter();
                renderDashboard();
                renderInventoryTable();
                showToast('Producto eliminado', 'info');
            }
        }

        // --- GESTIÓN DE MOVIMIENTOS DE STOCK ---
        function openStockMovementModal() {
            const select = document.getElementById('movProductId');
            select.innerHTML = '';

            products.forEach(p => {
                select.innerHTML += `<option value="${p.id}">${p.sku} - ${p.name} (Actual: ${p.stock})</option>`;
            });

            document.getElementById('movementForm').reset();
            document.getElementById('movementModal').classList.remove('hidden');
        }

        function closeStockMovementModal() {
            document.getElementById('movementModal').classList.add('hidden');
        }

        function handleMovementSubmit(e) {
            e.preventDefault();

            const productId = document.getElementById('movProductId').value;
            const type = document.querySelector('input[name="movType"]:checked').value;
            const quantity = parseInt(document.getElementById('movQuantity').value);
            const notes = document.getElementById('movNotes').value.trim();

            const product = products.find(p => p.id === productId);
            if (!product) return;

            if (type === 'OUT' && product.stock < quantity) {
                showToast('Stock insuficiente para realizar la salida', 'error');
                return;
            }

            // Actualizar stock del producto
            if (type === 'IN') {
                product.stock += quantity;
            } else {
                product.stock -= quantity;
            }

            // Registrar movimiento en el historial
            movements.unshift({
                id: Date.now().toString(),
                date: new Date().toLocaleString(),
                productId: product.id,
                productName: product.name,
                type: type,
                quantity: quantity,
                notes: notes || (type === 'IN' ? 'Entrada manual' : 'Salida manual')
            });

            saveData();
            renderDashboard();
            renderInventoryTable();
            renderMovementsTable();
            closeStockMovementModal();
            showToast('Movimiento de stock registrado', 'success');
        }

        function renderMovementsTable() {
            const tbody = document.getElementById('movementsTableBody');
            tbody.innerHTML = '';

            if (movements.length === 0) {
                tbody.innerHTML = `<tr><td colspan="5" class="py-8 text-center text-slate-400">No hay movimientos registrados.</td></tr>`;
                return;
            }

            movements.forEach(m => {
                const isEntry = m.type === 'IN';
                const tr = document.createElement('tr');
                tr.className = 'hover:bg-slate-50 border-b border-slate-100 transition';
                tr.innerHTML = `
                    <td class="py-3 px-4 text-xs text-slate-500">${m.date}</td>
                    <td class="py-3 px-4">
                        <span class="inline-flex items-center space-x-1 px-2.5 py-0.5 rounded-full text-xs font-semibold ${isEntry ? 'bg-emerald-100 text-emerald-800' : 'bg-rose-100 text-rose-800'}">
                            <i data-lucide="${isEntry ? 'arrow-down-left' : 'arrow-up-right'}" class="w-3 h-3"></i>
                            <span>${isEntry ? 'Entrada' : 'Salida'}</span>
                        </span>
                    </td>
                    <td class="py-3 px-4 font-medium text-slate-900">${m.productName}</td>
                    <td class="py-3 px-4 font-bold ${isEntry ? 'text-emerald-600' : 'text-rose-600'}">
                        ${isEntry ? '+' : '-'}${m.quantity}
                    </td>
                    <td class="py-3 px-4 text-slate-600 text-xs">${m.notes || '-'}</td>
                `;
                tbody.appendChild(tr);
            });

            lucide.createIcons();
        }

        // --- EXPORTAR A CSV ---
        function exportToCSV() {
            if (products.length === 0) {
                showToast('No hay datos para exportar', 'error');
                return;
            }

            let csvContent = "data:text/csv;charset=utf-8,";
            csvContent += "SKU,Nombre,Categoria,Ubicacion,Stock,Stock Minimo,Costo Unitario,Valor Total\n";

            products.forEach(p => {
                const total = p.stock * p.cost;
                const row = [
                    `"${p.sku}"`,
                    `"${p.name}"`,
                    `"${p.category}"`,
                    `"${p.location || ''}"`,
                    p.stock,
                    p.minStock,
                    p.cost.toFixed(2),
                    total.toFixed(2)
                ].join(",");
                csvContent += row + "\n";
            });

            const encodedUri = encodeURI(csvContent);
            const link = document.createElement("a");
            link.setAttribute("href", encodedUri);
            link.setAttribute("download", `inventario_${new Date().toISOString().slice(0,10)}.csv`);
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);

            showToast('Inventario exportado a CSV correctamente', 'success');
        }

